{
  "cleanUrls": true,
  "functions": {
    "api/notify.js": {
      "maxDuration": 15
    },
    "api/pago.js": {
      "maxDuration": 15
    },
    "api/bot.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
